# Where the client runs: the exact origin(s) allowed to connect, comma-separated, no trailing slash. Local development:
CLIENT_ORIGIN=http://localhost:5173
# To try it from a phone on your network, list that address as well, for example:
# CLIENT_ORIGIN=http://localhost:5173,http://192.168.1.20:5173

# Port to listen on (most hosts set this for you)
# PORT=3001

# Set to true ONLY when deployed behind a proxy you control (Render, nginx...).
# TRUST_PROXY=true

# Other settings (reconnect time, lobby batching, rate limits) are described in the main README, under "Configuration".